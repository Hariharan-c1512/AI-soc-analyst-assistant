# ===== AI SOC Analyst Assistant - Environment Configuration =====
# Copy this file to .env and adjust values as needed.

# --- Backend ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
# Options: sqlite (default, zero setup) | postgres
DATABASE_URL=sqlite:///./data/socanalyst.db
# Example for Postgres:
# DATABASE_URL=postgresql+psycopg2://socadmin:socpass@localhost:5432/socanalyst

# --- Alert Ingestion ---
# Mock mode generates realistic alerts with no external dependencies.
# system mode reads real journald logs (detects SSH brute force, sudo misuse...).
# wazuh mode searches alerts in a live Wazuh Indexer.
# Options: mock | system | wazuh
INGESTION_MODE=mock
MOCK_ALERT_INTERVAL_SECONDS=30
SYSTEM_LOG_INTERVAL_SECONDS=10

# --- Wazuh Indexer (only used when INGESTION_MODE=wazuh) ---
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=admin
WAZUH_VERIFY_SSL=false
WAZUH_POLL_INTERVAL_SECONDS=30

# --- Sigma Rules ---
SIGMA_RULES_DIR=backend/sigma_rules

# --- ML Model ---
MODEL_PATH=backend/models/severity_model.pkl
MODEL_TYPE=random_forest
MIN_SAMPLES_FOR_TRAIN=100

# --- LLM ---
# llm_mode: ollama | offline
LLM_MODE=offline
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama
# offline fallback uses template-generated responses (no LLM needed)

# --- RAG / Embeddings ---
CHROMA_DIR=data/vector_store
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=3

# --- Frontend ---
BACKEND_URL=http://localhost:8000

# --- Logging ---
LOG_LEVEL=INFO
